# Kopieren nach .env und Werte anpassen, dann:
#   docker compose --env-file .env up -d --build

# HTTP Basic Auth fuer die gesamte Web-UI/API (Port 8080)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Wird u.a. in generierten Bootstrap-Scripten und der Web-UI verwendet
ORCHESTRATOR_HOST=192.168.178.26
CRON_SCHEDULE="0 3 * * *"
