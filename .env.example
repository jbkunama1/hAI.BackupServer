# Kopieren nach .env und Werte anpassen, dann:
#   docker compose --env-file .env pull && docker compose --env-file .env up -d
# Portainer: dieselben Werte als Stack-Umgebungsvariablen eintragen.

# --- Pflicht ---------------------------------------------------------------
# HTTP Basic Auth fuer Web-UI und Admin-API (Port 8080)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Allgemein -------------------------------------------------------------
# Adresse des Orchestrators (wird in generierte Scripte eingetragen)
ORCHESTRATOR_HOST=192.168.178.26
CRON_SCHEDULE="0 3 * * *"

# --- Enrollment (optional) -------------------------------------------------
# Leer = Enrollment deaktiviert. Lange Zufallszeichenfolge, z. B.: openssl rand -hex 24
ENROLL_TOKEN=

# --- Telegram-Bot (optional; zusaetzlich COMPOSE_PROFILES=telegram setzen) -----
# Token von @BotFather. Erlaubte Nutzer-IDs (numerisch, kommagetrennt), z. B. via @userinfobot.
# Nie in Chats, Tickets oder Commits teilen.
# COMPOSE_PROFILES=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
DIGEST_TIME=08:00
DIGEST_TZ=Europe/Berlin
